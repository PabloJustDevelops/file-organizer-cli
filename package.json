{
  "name": "file-organizer-cli",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/cli dev",
    "dev:cli": "bun run --cwd packages/cli dev",
    "build": "bun run --cwd packages/cli build",
    "build:cli": "bun run --cwd packages/cli build",
    "test": "bun run --cwd packages/cli test",
    "lint": "bun run --cwd packages/cli lint",
    "prepublishOnly": "bun run --cwd packages/cli build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
