{
  "name": "@pablojustdevs/file-organizer-cli",
  "version": "0.1.0-rc.1",
  "description": "CLI tool to automatically organize files based on configurable rules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fo": "dist/cli/index.js",
    "file-organizer": "dist/cli/index.js",
    "fo-tui": "dist/tui/index.js",
    "file-organizer-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && tsc --noEmit",
    "lint:oxlint": "oxlint",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "cli",
    "file-organizer",
    "automation",
    "file-management",
    "duplicate-finder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloJustDevelops/file-organizer-cli.git"
  },
  "homepage": "https://github.com/PabloJustDevelops/file-organizer-cli#readme",
  "bugs": {
    "url": "https://github.com/PabloJustDevelops/file-organizer-cli/issues"
  },
  "author": {
    "name": "Pablo",
    "url": "https://github.com/PabloJustDevelops"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^6.0.0",
    "chokidar": "^3.6.0",
    "commander": "^15.0.0",
    "conf": "^15.0.0",
    "figures": "^6.1.0",
    "fs-extra": "^11.2.0",
    "ink": "^7.1.1",
    "inquirer": "^14.0.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.83.0",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "memfs": "^4.78.0",
    "oxlint": "^1.83.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ]
}
